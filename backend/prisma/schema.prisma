generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Authentication & User Management
// ============================================================

model User {
  id               String    @id @default(uuid())
  email            String    @unique
  passwordHash     String
  role             Role      @default(CREATOR)
  emailVerified    Boolean   @default(false)
  lockedUntil      DateTime? // Account lockout expiration
  failedLogins     Int       @default(0)
  profile          UserProfile?
  refreshTokens    RefreshToken[]
  emailVerifications EmailVerification[]
  auditLogs        AuditLog[]
  dealsAsBrand     Deal[]    @relation("BrandDeals")
  dealsAsCreator   Deal[]    @relation("CreatorDeals")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  @@index([email])
  @@index([role])
}

model UserProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String?
  company   String?
  bio       String?
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Refresh tokens stored for revocation support
model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique // SHA-256 hash of the token
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  revokedAt DateTime?

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
}

// Email verification tokens — stored as SHA-256 hash, not plaintext.
model EmailVerification {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([tokenHash])
  @@index([userId])
}

// ============================================================
// Deal Domain
// ============================================================

model Deal {
  id                    String        @id @default(uuid())
  brandId               String
  brand                 User          @relation("BrandDeals", fields: [brandId], references: [id])
  creatorId             String?
  creator               User?         @relation("CreatorDeals", fields: [creatorId], references: [id])
  status                DealStatus    @default(DRAFT)
  // acceptedVersionNumber tracks which DealVersion is currently authoritative.
  // Initially set to 1 when a deal is created. Updated when term proposals are accepted.
  // A value of null means no version has been explicitly accepted (legacy state).
  acceptedVersionNumber Int?
  // NOTE: Deal terms are NOT stored here. DealVersion is the authoritative source for versioned terms.
  contractId            String?
  fundingStatus         FundingStatus @default(NOT_FUNDED)
  versions              DealVersion[]
  auditLogs             AuditLog[]
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([brandId])
  @@index([creatorId])
  @@index([status])
  @@index([fundingStatus])
}

model DealVersion {
  id            String   @id @default(uuid())
  dealId        String
  deal          Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  versionNumber Int
  // isPending indicates this version is a proposed change awaiting counterparty acceptance.
  // A version with isPending=true must NOT be used for payments or as authoritative terms.
  // Once accepted, isPending is set to false (or the acceptedVersionNumber points to it).
  // A version with isPending=true that is rejected never becomes authoritative.
  isPending     Boolean  @default(false)
  terms         Json
  createdAt     DateTime @default(now())

  @@unique([dealId, versionNumber])
  @@index([dealId])
}

// ============================================================
// Audit Logging (for auth events and deal events)
// ============================================================

model AuditLog {
  id           String   @id @default(uuid())
  actorId      String?
  actor        User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  dealId       String?
  deal         Deal?    @relation(fields: [dealId], references: [id], onDelete: SetNull)
  action       String   // e.g., "AUTH.LOGIN", "AUTH.REGISTER", "AUTH.FAILED_LOGIN", "DEAL.CREATED", "DEAL.STATE_CHANGED"
  resourceType String   // e.g., "User", "Session", "Deal", "DealVersion"
  resourceId   String
  metadata     Json?    // { ipAddress, userAgent, ... }
  ipAddress    String?
  timestamp    DateTime @default(now())

  @@index([actorId])
  @@index([dealId])
  @@index([action])
  @@index([resourceType, resourceId])
  @@index([timestamp])
}

// ============================================================
// Enums
// ============================================================

enum Role {
  BRAND
  CREATOR
  HRT      // Human Review Team - dispute handling only
  ADMIN    // System administration - user management, audit logs
}

enum DealStatus {
  DRAFT
  PENDING_ACCEPTANCE
  ACCEPTED
  DECLINED
  FUNDED
  IN_PROGRESS
  SUBMITTED
  APPROVED
  REVISION_REQUESTED
  DISPUTED
  RESOLVED
  COMPLETED
  CANCELLED
}

enum FundingStatus {
  NOT_FUNDED
  FUNDED
  REFUNDED
}