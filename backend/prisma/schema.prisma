generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String              @id @default(uuid())
  email              String              @unique
  passwordHash       String
  role               Role                @default(CREATOR)
  emailVerified      Boolean             @default(false)
  lockedUntil        DateTime?
  failedLogins       Int                 @default(0)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime?
  auditLogs          AuditLog[]
  dealsAsBrand       Deal[]              @relation("BrandDeals")
  dealsAsCreator     Deal[]              @relation("CreatorDeals")
  emailVerifications EmailVerification[]
  refreshTokens      RefreshToken[]
  profile            UserProfile?

  @@index([email])
  @@index([role])
}

model UserProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  name      String?
  company   String?
  bio       String?
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
}

model EmailVerification {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([userId])
}

model Deal {
  id                         String        @id @default(uuid())
  brandId                    String
  creatorId                  String?
  status                     DealStatus    @default(DRAFT)
  contractId                 String?
  fundingStatus              FundingStatus @default(NOT_FUNDED)
  createdAt                  DateTime      @default(now())
  updatedAt                  DateTime      @updatedAt
  acceptedVersionNumber      Int?
  paymentRecordId            String?
  latestRevisionNote         String?
  latestRevisionNoteAuthorId String?
  latestRevisionNoteAt       DateTime?
  auditLogs                  AuditLog[]
  brand                      User          @relation("BrandDeals", fields: [brandId], references: [id])
  creator                    User?         @relation("CreatorDeals", fields: [creatorId], references: [id])
  versions                   DealVersion[]
  payment                    Payment?

  @@index([brandId])
  @@index([creatorId])
  @@index([status])
  @@index([fundingStatus])
}

model Payment {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  dealId    String   @unique
  amount    Int
  currency  String   @default("USD")
  status    String   @default("PENDING")
  paymentId String
  intentId  String
  actorId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  deal      Deal     @relation(fields: [dealId], references: [id])

  @@index([status])
  @@index([actorId])
}

model DealVersion {
  id            String   @id @default(uuid())
  dealId        String
  versionNumber Int
  terms         Json
  createdAt     DateTime @default(now())
  isPending     Boolean  @default(false)
  deal          Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@unique([dealId, versionNumber])
  @@index([dealId])
  @@index([dealId, isPending])
}

model AuditLog {
  id           String   @id @default(uuid())
  actorId      String?
  dealId       String?
  action       String
  resourceType String
  resourceId   String
  metadata     Json?
  ipAddress    String?
  timestamp    DateTime @default(now())
  actor        User?    @relation(fields: [actorId], references: [id])
  deal         Deal?    @relation(fields: [dealId], references: [id])

  @@index([actorId])
  @@index([dealId])
  @@index([action])
  @@index([resourceType, resourceId])
  @@index([timestamp])
}

enum Role {
  BRAND
  CREATOR
  HRT
  ADMIN
}

enum DealStatus {
  DRAFT
  PENDING_ACCEPTANCE
  ACCEPTED
  DECLINED
  FUNDED
  IN_PROGRESS
  SUBMITTED
  APPROVED
  REVISION_REQUESTED
  DISPUTED
  RESOLVED
  COMPLETED
  CANCELLED
}

enum FundingStatus {
  NOT_FUNDED
  FUNDED
  REFUNDED
}
