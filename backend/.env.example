# ============================================================
# Ledger Backend Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# Server
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3001

# Proxy trust mode for X-Forwarded-For:
#   disabled  - do not trust any proxy (safe default, uses direct peer IP)
#   loopback  - trust only loopback proxy (127.0.0.1, ::1)
#   uniquelocal - trust private/loopback address ranges
#   true      - trust all proxies (UNSAFE in multi-tenant deployments)
#   1, 2, ... - trust exactly N proxy hops
TRUST_PROXY=disabled

# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/ledger_db"

# JWT Authentication — generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Must be at least 32 characters. Never use placeholder values in production.
JWT_SECRET=change-me-in-production
REFRESH_TOKEN_SECRET=change-me-in-production

# Token Expiration
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# BCrypt
BCRYPT_ROUNDS=12

# Rate Limiting
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=5

# Email Verification
EMAIL_VERIFICATION_EXPIRES_IN=86400000
EMAIL_FROM=noreply@ledger.local

# Cookie Security
# SameSite: strict (same host only) | lax (top-level nav, sub-domains ok) | none (cross-site, requires Secure)
#   Use 'strict' when frontend and backend are on the same host.
#   Use 'lax' when frontend and backend share the same registrable domain (e.g. app.example.com / api.example.com).
#   Use 'none' only with Secure=true and HTTPS in production.
COOKIE_SAMESITE=lax
# Secure: 'true' requires HTTPS. In production this should be true.
COOKIE_SECURE=false
# Allow SameSite=none in non-production (browsers normally block this). Set to 'true' to override.
COOKIE_ALLOW_NONE_INSECURE=false
