# Ledger MVP — Frontend Environment Variables
# Copy this file to .env.local and fill in values for local development.
# Variables prefixed with VITE_ are exposed to the browser bundle.

# -----------------------------------------------------------------------
# Mock vs Real Backend
# -----------------------------------------------------------------------
# When VITE_USE_MOCK_DEALS is true (default), the frontend uses static
# mock data from dealApi.ts / invitationApi.ts. No backend server is needed.
#
# Set to false to use the real backend API. The backend must be running
# and the database must be seeded with:
#   cd backend && npm run prisma:seed
#
# The persona switcher (top-right corner) lets you switch between mock users
# in either mode. In real-backend mode, the X-Mock-User header is forwarded
# to the backend for authentication.
VITE_USE_MOCK_DEALS=true

# Base URL of the real backend API. Only used when VITE_USE_MOCK_DEALS=false.
# Default: http://localhost:3000/api
VITE_API_BASE_URL=http://localhost:3000/api
