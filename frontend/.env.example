# Ledger MVP — Frontend Environment Variables
# Copy this file to .env.local and fill in values for local development.
# Variables prefixed with VITE_ are exposed to the browser bundle.

# -----------------------------------------------------------------------
# API connection
# -----------------------------------------------------------------------
# All transactions use the real backend. During development, Vite proxies
# /api to the local backend on port 3000. The database must already be set up.
VITE_API_BASE_URL=/api

# Optional seeded account switcher for local workflow testing. Requires the
# backend's development mock-auth support. Disabled in production builds.
# Real email/password sign-in remains available with either setting.
VITE_ENABLE_DEV_PERSONAS=false
